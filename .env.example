# Copy to .env and fill in values. Never commit .env.

DB_URL=jdbc:oracle:thin:@localhost:1523/XEPDB1
DB_USERNAME=
DB_PASSWORD=

MAIL_HOST=smtp.naver.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

NTS_SERVICE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8282/login/oauth2/code/kakao

ADMIN_LOGIN_ID=
ADMIN_PASSWORD=
