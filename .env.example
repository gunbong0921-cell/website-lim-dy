# Hexaq. .env 로 복사하고 값을 채운다. .env 는 커밋하지 않는다.
# 상세: [docs/technical/02-technical-specification.md](docs/technical/02-technical-specification.md) · [docs/technical/04-redis.md](docs/technical/04-redis.md)

# 로컬·tunnel: Oracle. prod 프로필: jdbc:mariadb://{host}:3306/{db}
DB_URL=jdbc:oracle:thin:@localhost:1523/XEPDB1
DB_USERNAME=
DB_PASSWORD=

MAIL_HOST=smtp.naver.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

NTS_SERVICE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8282/login/oauth2/code/kakao

ADMIN_LOGIN_ID=
ADMIN_PASSWORD=
ADMIN_NAME=관리자
ADMIN_EMAIL=
ADMIN_PHONE=

# 인증 코드·HMAC 티켓·이상 탐지. 회원·게시글이 아니다. Docker: docker-compose.redis.yml · docs/technical/04-redis.md
# redis 이면 localhost:6379 가 살아 있어야 한다. 로컬만이면 PHONE_VERIFY_STORE=memory
REDIS_HOST=localhost
REDIS_PORT=6379
PHONE_VERIFY_STORE=redis

RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# HMAC 티켓 TTL(초). Redis REQ_TICKET:
REQUEST_SIGNING_ENABLED=true
REQUEST_TICKET_TTL_SECONDS=60
REQUEST_SIGNING_MAX_SKEW_SECONDS=300

# 이상 탐지. 신호는 Redis ANOMALY:* , 계정 상태는 DB trust_status
ANOMALY_GUARD_ENABLED=true
ANOMALY_TTFA_MS=3000
ANOMALY_NEW_USER_AGE_HOURS=24
ANOMALY_NEW_USER_LIMIT=5
ANOMALY_NEW_USER_WINDOW_SECONDS=60
ANOMALY_NAV_LOOKBACK_SECONDS=300
ANOMALY_NAV_MAX_ENTRIES=50
ANOMALY_DIRECT_HIT_LIMIT=1
ANOMALY_SIGNUP_TTL_HOURS=24
ANOMALY_STEP_TTL_HOURS=24

# 사이트는 연다. 남용만 줄인다. 레이트 리밋은 프로세스 메모리(Redis 아님).
CORS_ALLOWED_ORIGINS=http://localhost:8282,http://127.0.0.1:8282,https://*.trycloudflare.com
# 터널·리버스 프록시 뒤에서만 true. 프로필 tunnel 기본값 true.
TRUSTED_PROXY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_PAGE=300
