# Public site stays open. These only throttle abusive traffic.
CORS_ALLOWED_ORIGINS=http://localhost:8282,http://127.0.0.1:8282
TRUSTED_PROXY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_PAGE=300
